# --- Développement ---------------------------------------------------------
# Sans DATABASE_URL, l'application utilise PGlite (PostgreSQL embarqué) dans .data/pglite,
# initialisé au premier lancement (sites, catalogue, compte Direction, créneaux d'exemple).
# DIRECTION_PIN=123456

# --- Production (secrets Cloudflare : npx wrangler secret put NOM) -----------
# Chaîne de connexion Supabase, pooler en mode transaction (port 6543).
# DATABASE_URL=postgres://postgres.xxxx:motdepasse@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Au moins 32 caractères aléatoires (ex. : openssl rand -base64 48).
# SESSION_SECRET=
# Jeton d'accès Loyverse (Back Office › Intégrations › Jetons d'accès).
# LOYVERSE_TOKEN=
